{
  "name": "contently",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "routes:generate": "node scripts/generate-routes.mjs",
    "routes:watch": "node scripts/generate-routes.mjs --watch",
    "api:generate": "orval --config orval.config.ts",
    "codegen": "npm run routes:generate && npm run api:generate",
    "predev": "npm run codegen",
    "dev": "concurrently -k -n routes,next -c magenta,cyan \"npm run routes:watch\" \"next dev\"",
    "prebuild": "npm run codegen",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.3",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "next": "16.2.11",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "orval": "^8.22.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

{
  "name": "contently",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "routes:generate": "node scripts/generate-routes.mjs",
    "routes:watch": "node scripts/generate-routes.mjs --watch",
    "predev": "npm run routes:generate",
    "dev": "concurrently -k -n routes,next -c magenta,cyan \"npm run routes:watch\" \"next dev\"",
    "prebuild": "npm run routes:generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.2.11",
    "next-intl": "^4.13.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.9.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
